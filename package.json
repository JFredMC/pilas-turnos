{
  "name": "pilas",
  "version": "0.0.0",
  "private": true,
  "description": "Pilas: app de turnos para peluquerías de Turbo, Antioquia (monorepo: web Angular + API NestJS/PostgreSQL)",
  "license": "MIT",
  "author": "Jhon Maquilon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JFredMC/pilas-turnos.git"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r run lint",
    "e2e": "pnpm --filter ./apps/web run e2e"
  },
  "devDependencies": {
    "prettier": "^3.8.1"
  }
}
