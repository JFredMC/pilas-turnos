# Copia este archivo a apps/api/.env (no se versiona).
PORT=3000
DATABASE_URL=postgres://pilas:pilas@localhost:5432/pilas
# Obligatorio en producción: una cadena larga y aleatoria (Render la genera sola).
JWT_SECRET=
CORS_ORIGINS=http://localhost:4200,https://jfredmc.github.io
# Web para los enlaces de los correos.
APP_URL=http://localhost:4200
# "ses" para enviar con Amazon SES; cualquier otro valor escribe el correo en el log (solo en desarrollo).
MAIL_PROVIDER=log
SES_AWS_REGION=us-east-2
SES_FROM_EMAIL=
# Credenciales AWS estándar (usuario IAM con permiso ses:SendEmail). No las versiones.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Recordatorios por WhatsApp Cloud API (Meta). Sin token no se envía nada: el panel muestra enlaces wa.me.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=recordatorio_cita
WHATSAPP_TEMPLATE_LANG=es
# Token (mín. 24 caracteres) para POST /api/interno/recordatorios desde el cron de GitHub Actions.
CRON_TOKEN=
RECORDATORIOS_CADA_MIN=10
